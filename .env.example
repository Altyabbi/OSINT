# 数据库：默认 SQLite（本地/演示），生产切 PostgreSQL+PostGIS（docker compose up -d 后启用下行）
DATABASE_URL=sqlite:///data/osint.db
# DATABASE_URL=postgresql+psycopg2://osint:osint@localhost:5432/osint

# WarSpotting API
WARSPOTTING_BASE_URL=https://warspotting.net/api/losses/russia
REQUEST_INTERVAL_SECONDS=1.5
REQUEST_TIMEOUT_SECONDS=30
MAX_RETRIES=5
BACKOFF_BASE_SECONDS=2

# LLM（OpenAI 兼容）。不配置 OPENAI_API_KEY 时，日报/问答自动走确定性 fallback。
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# 定时采集时间（APScheduler，每日）
SCHEDULER_HOUR=6
SCHEDULER_MINUTE=40
